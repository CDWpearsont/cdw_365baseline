{
  "displayName": "CDW100 - Mobile BYOD - Require Compliant Device or Approved App - v1.0",
  "description": "Conditional Access policy for Android and iOS BYOD access to Microsoft 365. Requires either a compliant enrolled device OR an approved client app with App Protection Policy (MAM). Allows BYOD users to access M365 via MAM-protected apps without full MDM enrolment, while also permitting fully managed compliant devices. Created in disabled state — enable after validating exclusions.",
  "state": "disabled",
  "conditions": {
    "users": {
      "includeUsers": [],
      "excludeUsers": [],
      "includeGroups": [
        "REPLACE_WITH_TARGET_GROUP_ID"
      ],
      "excludeGroups": [
        "REPLACE_WITH_BREAKGLASS_GROUP_ID"
      ],
      "includeRoles": [],
      "excludeRoles": []
    },
    "applications": {
      "includeApplications": [
        "Office365"
      ],
      "excludeApplications": [],
      "includeUserActions": [],
      "includeAuthenticationContextClassReferences": []
    },
    "platforms": {
      "includePlatforms": [
        "android",
        "iOS"
      ],
      "excludePlatforms": []
    },
    "locations": {
      "includeLocations": [
        "All"
      ],
      "excludeLocations": [
        "AllTrusted"
      ]
    },
    "clientAppTypes": [
      "browser",
      "mobileAppsAndDesktopClients"
    ],
    "signInRiskLevels": [],
    "userRiskLevels": []
  },
  "grantControls": {
    "operator": "OR",
    "builtInControls": [
      "compliantDevice",
      "approvedApplication",
      "compliantApplication"
    ],
    "customAuthenticationFactors": [],
    "termsOfUse": []
  },
  "sessionControls": {
    "signInFrequency": {
      "value": 1,
      "type": "days",
      "isEnabled": true,
      "frequencyInterval": "timeBased",
      "authenticationType": "primaryAndSecondaryAuthentication"
    },
    "persistentBrowser": {
      "mode": "never",
      "isEnabled": true
    }
  }
}
